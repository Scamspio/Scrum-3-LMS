@startuml
actor Medewerker
participant "LMS Systeem" as Systeem
actor Gebruiker

==  Magazijn & Inname ==
Medewerker -> Systeem : Registreer nieuw boek (Inname)
Systeem -> Systeem : Voeg toe aan voorraad (Magazijn)

==  Bestellen via Leerlijst ==
Gebruiker -> Systeem : Open leerlijst
Systeem -> Gebruiker : Toon beschikbare boeken
Gebruiker -> Systeem : Bestel boeken (+ extra items)
Gebruiker -> Systeem : Betaal bestelling
Systeem -> Systeem : Verwerk betaling

==  Uitlevering ==
Systeem -> Medewerker : Verzendopdracht (Individueel of Bulk)
Medewerker -> Gebruiker : Stuur boeken op

==  Terugnames ==
Gebruiker -> Medewerker : Stuur boeken retour
Medewerker -> Systeem : Scan retour
Systeem -> Systeem : Update voorraad (Inname)
@enduml